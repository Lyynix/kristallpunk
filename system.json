{
  "id": "kristallpunk",
  "title": "KRISTALLPUNK",
  "description": "Spielsystem für das Pen-&-Paper-Rollenspiel Kristallpunk (kristallpunk.de).",
  "version": "{{version}}",
  "compatibility": {
    "minimum": "14",
    "verified": "14",
    "maximum": "14"
  },
  "authors": [
    {
      "name": "Lyynix",
      "discord": "lyynix"
    }
  ],
  "esmodules": [
    "kristallpunk.mjs"
  ],
  "styles": [
    "styles/kristallpunk.css"
  ],
  "languages": [
    {
      "lang": "de",
      "name": "Deutsch",
      "path": "lang/de.json"
    }
  ],
  "documentTypes": {
    "Actor": {
      "protagonist": {
        "htmlFields": ["background", "relationships", "equipment"]
      }
    },
    "Item": {
      "equipment": {
        "htmlFields": ["description"]
      },
      "competence": {
        "htmlFields": ["description"]
      },
      "innateTrait": {
        "htmlFields": ["description"]
      }
    },
    "ChatMessage": {
      "check": {},
      "checkRequest": {}
    }
  },
  "packs": [
    {
      "name": "equipment",
      "label": "Ausrüstung",
      "path": "packs/equipment",
      "type": "Item",
      "system": "kristallpunk",
      "ownership": { "PLAYER": "OBSERVER", "ASSISTANT": "OWNER" }
    },
    {
      "name": "competences",
      "label": "Kompetenzen",
      "path": "packs/competences",
      "type": "Item",
      "system": "kristallpunk",
      "ownership": { "PLAYER": "OBSERVER", "ASSISTANT": "OWNER" }
    },
    {
      "name": "innateTraits",
      "label": "Angeborene Eigenschaften",
      "path": "packs/innateTraits",
      "type": "Item",
      "system": "kristallpunk",
      "ownership": { "PLAYER": "OBSERVER", "ASSISTANT": "OWNER" }
    }
  ],
  "primaryTokenAttribute": "stamina.body",
  "secondaryTokenAttribute": "stamina.mind",
  "grid": {
    "distance": 1,
    "units": "m"
  },
  "url": "https://github.com/Lyynix/kristallpunk",
  "bugs": "https://github.com/Lyynix/kristallpunk/issues",
  "readme": "https://github.com/Lyynix/kristallpunk/blob/main/README.md",
  "license": "LICENSE",
  "manifest": "{{manifestURL}}",
  "download": "{{downloadURL}}"
}
