<ol class="combat-tracker plain">
  {{#each turns}}
  <li class="combatant {{ css }}" data-combatant-id="{{ id }}" data-action="activateCombatant">
    <img class="token-image" src="{{ img }}" alt="{{ name }}" loading="lazy">
    <div class="token-name">
      <strong class="name">{{ name }}</strong>
      <div class="combatant-controls">

        {{!-- Add GM buttons --}}
        {{#if @root.user.isGM}}
        {{!-- Hide --}}
        <button type="button"
          class="inline-control fa-solid fa-eye-slash combatant-control icon {{#if hidden}}active{{/if}}"
          data-action="toggleHidden"
          data-tooltip
          aria-label="{{ localize (ifThen hidden "COMBATANT.Show" "COMBATANT.Hide" ) }}"></button>
        {{!-- Mark Defeated --}}
        <button type="button"
          class="inline-control fa-solid fa-skull combatant-control icon {{#if isDefeated}}active{{/if}}"
          data-action="toggleDefeated"
          data-tooltip
          aria-label="{{ localize (ifThen isDefeated "COMBATANT.UnmarkDefeated" "COMBATANT.MarkDefeated" ) }}"></button>
        {{/if}}

        {{!-- Add Ping button --}}
        {{#if canPing}}
        <button type="button"
          class="inline-control fa-solid fa-bullseye-arrow combatant-control icon"
          data-action="pingCombatant"
          data-tooltip
          aria-label="{{ localize "COMBATANT.Ping" }}"></button>
        {{/if}}

        {{!-- Add Player buttons --}}
        {{#unless @root.user.isGM}}
        {{!-- Pan to combatant --}}
        <button type="button"
          class="inline-control fa-solid fa-arrows-to-eye combatant-control icon"
          data-action="panToCombatant"
          data-tooltip
          aria-label="{{ localize "COMBATANT.PanTo" }}"></button>
        {{/unless}}

        {{!-- Add effect icons --}}
        <div class="token-effects" data-tooltip-html="{{ effects.tooltip }}">
          {{#each effects.icons}}
          <img class="token-effect" src="{{ img }}" alt="{{ name }}">
          {{/each}}
        </div>
      </div>
    </div>

    {{!-- Initiative --}}
    <div class="token-initiative">
      {{!-- Add initiative if available --}}
      {{#if initiative includeZero=true}}
      <input type="text"
        class="initiative-input"
        inputmode="numeric" pattern="^[+=\-]?\d*" value="{{initiative}}"
        aria-label="{{localize "COMBATANT.FIELDS.initiative.label"}}" {{#unless @root.user.isGM}}readonly{{/unless}}>

      {{!-- Add roll-button if client is an owner --}}
      {{else if isOwner}}
      <button type="button"
        class="combatant-control roll"
        data-action="rollInitiative" data-tooltip
        aria-label="{{ localize "COMBAT.InitiativeRoll" }}"
        style="--initiative-icon: url('{{ @root.initiativeIcon.icon }}'); --initiative-icon-hover: url('{{ @root.initiativeIcon.hover }}');"></button>
      {{/if}}
    </div>
    {{!-- Add Handle --}}
    <i class="fa-solid fa-grip-vertical kp-handle {{#unless canMove}}kp-hidden{{/unless}}" aria-hidden="true"
      data-tooltip="KRISTALLPUNK.Combat.HandleHint"></i>
  </li>
  {{/each}}
</ol>
