<div class="kristallpunk check-card">
  <header class="check-title">
    <span class="check-label">{{label}}</span>
    <span class="check-grade">{{localize grade}}</span>
  </header>
  <ol class="check-dice">
    {{#each dice as |die|}}
    <li class="die {{die.highlight}}" data-face="{{die.face}}" aria-label="{{die.face}}">
      <i class="{{die.icon}}" inert></i>
    </li>
    {{/each}}
  </ol>
  <p class="check-outcome {{outcome}}">
    {{localize "KRISTALLPUNK.Check.Successes" count=result.successes}} ·
    <strong>{{#if result.success}}{{localize "KRISTALLPUNK.Check.Success"}}{{else}}{{localize "KRISTALLPUNK.Check.Failure"}}{{/if}}</strong>
    {{#if result.criticalSuccess}}<span class="critical success">{{localize "KRISTALLPUNK.Check.CriticalSuccess"}}</span>{{/if}}
    {{#if result.criticalFailure}}<span class="critical failure">{{localize "KRISTALLPUNK.Check.CriticalFailure"}}</span>{{/if}}
  </p>
  {{#if reroll.option}}
  <button type="button" class="reroll" data-action="rerollWithConviction" data-tooltip="{{localize reroll.option.hint}}">
    <i class="fa-solid fa-dice" inert></i> {{localize "KRISTALLPUNK.Check.Reroll.Button"}}
  </button>
  {{/if}}
  {{#if cost}}
  <p class="check-cost {{#if cost.applied}}applied{{else}}open{{/if}}">
    {{localize "KRISTALLPUNK.Check.Cost.Label"}}: {{cost.payments}}
    {{#if cost.applied}}
    <i class="cost-state fa-solid fa-check" role="img" data-tooltip="{{localize "KRISTALLPUNK.Check.Cost.Applied"}}"
       aria-label="{{localize "KRISTALLPUNK.Check.Cost.Applied"}}"></i>
    {{else}}
    <i class="cost-state fa-solid fa-hourglass-half" role="img" data-tooltip="{{localize "KRISTALLPUNK.Check.Cost.Open"}}"
       aria-label="{{localize "KRISTALLPUNK.Check.Cost.Open"}}"></i>
    {{/if}}
  </p>
  {{#if cost.canApply}}
  <button type="button" class="apply-cost" data-action="applyCost">
    <i class="fa-solid fa-check" inert></i> {{localize "KRISTALLPUNK.Check.Cost.Apply"}}
  </button>
  {{/if}}
  {{/if}}
  {{#if conviction}}
  <p class="check-conviction {{#if conviction.applied}}applied{{else}}open{{/if}}">
    {{localize "KRISTALLPUNK.Check.Conviction.Label"}}: {{conviction.change}}
    {{#if conviction.limit}}<span class="limit">({{localize "KRISTALLPUNK.Check.Conviction.Limit"}})</span>{{/if}}
    {{#if conviction.applied}}
    <i class="state fa-solid fa-check" role="img" data-tooltip="{{localize "KRISTALLPUNK.Check.Conviction.Applied"}}"
       aria-label="{{localize "KRISTALLPUNK.Check.Conviction.Applied"}}"></i>
    {{else}}
    <i class="state fa-solid fa-hourglass-half" role="img" data-tooltip="{{localize "KRISTALLPUNK.Check.Conviction.Open"}}"
       aria-label="{{localize "KRISTALLPUNK.Check.Conviction.Open"}}"></i>
    {{/if}}
    {{#if conviction.parts}}<span class="parts">{{conviction.parts}}</span>{{/if}}
  </p>
  {{#if conviction.canApply}}
  <button type="button" class="apply-conviction" data-action="applyConviction">
    <i class="fa-solid fa-check" inert></i> {{localize "KRISTALLPUNK.Check.Conviction.Apply"}}
  </button>
  {{/if}}
  {{/if}}
  {{#if reroll.history}}
  <details class="check-history">
    <summary>{{localize "KRISTALLPUNK.Check.Reroll.History"}}</summary>
    {{#each reroll.history as |step|}}
    <div class="history-step">
      <span class="step-label">{{step.label}}</span>
      <ol class="check-dice">
        {{#each step.dice as |die|}}
        <li class="die {{#if die.kept}}kept{{/if}}" data-face="{{die.face}}" aria-label="{{die.face}}"
            {{#if die.kept}}data-tooltip="{{localize "KRISTALLPUNK.Check.Reroll.Kept"}}"{{/if}}><i class="{{die.icon}}" inert></i></li>
        {{/each}}
      </ol>
    </div>
    {{/each}}
  </details>
  {{/if}}
  <details class="check-pool">
    <summary>{{localize "KRISTALLPUNK.CheckDialog.Preview.Dice" count=pool.dice}}</summary>
    <ul>{{#each pool.lines as |line|}}<li>{{line}}</li>{{/each}}</ul>
  </details>
</div>
