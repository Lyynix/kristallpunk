{{!-- Checks of the bar, shared by the character mode (#32) and the GM mode (#33); context from
      prepareChecks() in module/apps/token-hotbar.mjs. Folded in to a strip at first; the bar folds them out
      (class "checks-open"). In the GM mode the cards show no values, a click requests the check. --}}
<div class="figure-checks">
  <div class="checks-folded" aria-hidden="true">
    <i class="fa-solid fa-chevron-left" inert></i>
    <i class="fa-solid fa-dice" inert></i>
    <span>{{localize "KRISTALLPUNK.Hotbar.Checks"}}</span>
  </div>
  {{!-- Each group is a card that sits at the bottom of its slot; at rest it shows as many rows as the
        derived values. When the checks fold out, all cards grow upwards over the bar one column after
        the other, and only then. Tooltips anchor above the card. --}}
  <div class="checks-list" role="group" aria-label="{{localize "KRISTALLPUNK.Hotbar.Checks"}}"
       style="--kp-rest-rows: {{restRows}}">
    {{#each groups as |group|}}
    <div class="check-group {{group.key}}" style="--kp-rows: {{group.rows}}; --kp-column: {{@index}}">
      <div class="check-card{{#if group.more}} more{{/if}}" data-tooltip-anchor>
        <span class="check-group-label">{{group.label}}</span>
        {{#each group.entries as |entry|}}
        {{!-- "../../": the checks, not the group or entry --}}
        <button type="button" class="check" data-check="{{entry.key}}" data-tooltip-text="{{entry.tooltip}}"
                {{#if ../../disabled}}disabled{{/if}}>
          <span class="check-name">{{entry.label}}</span>
          {{#if ../../showValues}}<span class="check-value">{{entry.value}}</span>{{/if}}
        </button>
        {{/each}}
      </div>
    </div>
    {{/each}}
  </div>
</div>
