{{!-- The system's bar (#31). One frame: with a figure the character mode (#32), whose macros fold out
      beside the status tracker (#35); without one the GM mode (#33) for GMs, otherwise a hint and the macros. Keeps the ids and actions of
      Foundry's macro bar (see hotbar-macros.hbs), so the logic inherited from its Hotbar class keeps working.
      Tooltips of the whole bar point up; the bar sets the direction on its element. --}}
<aside id="hotbar">
  {{!-- Mute and main menu concern the whole game --}}
  <div id="hotbar-controls-left" class="hotbar-controls flexcol">
    <button type="button" class="ui-control fa-solid fa-volume icon" data-action="mute" data-tooltip
            aria-label="{{localize "HOTBAR.ACTIONS.Mute"}}"></button>
    <button type="button" class="ui-control fa-solid fa-bars icon" data-action="menu" data-tooltip
            aria-label="{{localize "HOTBAR.ACTIONS.Menu"}}"></button>
  </div>

  <div class="hotbar-main">
    {{#if figure}}
    {{> "systems/kristallpunk/templates/ui/token-hotbar.hbs" figure}}
    {{else if gm}}
    {{> "systems/kristallpunk/templates/ui/gm-hotbar.hbs" gm}}
    {{else}}
    {{!-- Without a figure the macros are always shown --}}
    <div class="no-figure">
      <p class="placeholder">{{localize "KRISTALLPUNK.Hotbar.NoFigure"}}</p>
      {{> "systems/kristallpunk/templates/ui/hotbar-macros.hbs"}}
    </div>
    {{/if}}
  </div>

  <div class="hotbar-controls hotbar-toggle flexcol">
    <button type="button" class="ui-control fa-solid fa-table-cells icon" data-action="toggleMacros"
            data-tooltip></button>
  </div>
</aside>
