<div class="check-preview standard-form" aria-live="polite">
  <span class="dice">
    <i class="fa-solid fa-dice-d6" inert></i>
    {{localize "KRISTALLPUNK.CheckDialog.Preview.Dice" count=preview.dice}}
  </span>
  <ul class="details">
    {{#each preview.lines as |line|}}<li>{{line}}</li>{{/each}}
  </ul>
</div>
