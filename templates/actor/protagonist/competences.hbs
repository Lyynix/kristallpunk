<section class="standard-form tab competences {{tab.cssClass}}" data-tab="{{tab.id}}" data-group="{{tab.group}}">
  {{!-- Innate traits as tags side by side (#47): the name opens the trait, the x removes it, free places add one --}}
  <fieldset class="innate-trait-tags">
    <legend>{{localize "KRISTALLPUNK.Sheet.InnateTraits"}}</legend>
    {{#each innateTraitSlots as |slot|}}
    {{#if slot.item}}
    <span class="trait-tag {{slot.column}} {{#if slot.item.warning}}conflict{{/if}}" data-item-id="{{slot.item.id}}"
          {{#if slot.item.warning}}data-tooltip="{{slot.item.warning}}"{{/if}}>
      {{#if slot.item.warning}}<i class="warning fa-solid fa-triangle-exclamation" inert></i>{{/if}}
      <a class="trait-name" data-action="editItem">{{slot.item.name}}</a>
      {{#if slot.item.automation}}
      <i class="automation {{slot.item.automation.level}} fa-solid {{slot.item.automation.icon}}"
         data-tooltip="{{slot.item.automation.label}}" aria-label="{{slot.item.automation.label}}" role="img"></i>
      {{/if}}
      {{#if @root.editable}}
      <button type="button" class="inline-control icon fa-solid fa-xmark item-delete" data-action="deleteItem"
              data-tooltip="{{localize "KRISTALLPUNK.Items.Delete"}}" aria-label="{{localize "KRISTALLPUNK.Items.Delete"}}"></button>
      {{/if}}
    </span>
    {{else if @root.editable}}
    <button type="button" class="trait-tag empty {{slot.column}}" data-action="createItem" data-type="innateTrait">
      <i class="fa-solid fa-plus" inert></i> {{localize "KRISTALLPUNK.Sheet.AddInnateTrait"}}
    </button>
    {{/if}}
    {{/each}}
  </fieldset>

  {{!-- The former free text of innate traits, shown only while it still holds something; the file cleanup
        takes it over as items (#47). Resonance kinds stay free text until 0.7.0. --}}
  {{#if formerInnateTraits}}
  <fieldset class="innate-traits">
    <legend>{{localize "KRISTALLPUNK.Sheet.FormerInnateTraits"}}</legend>
    {{!-- Same name for all three: the form collects them into the array field --}}
    {{#each innateTraits as |trait|}}
    <input type="text" name="system.innateTraits" value="{{trait}}"
           aria-label="{{@root.systemFields.innateTraits.label}}" data-lockable {{disabled @root.locked}}>
    {{/each}}
  </fieldset>
  {{/if}}

  <div class="competence-columns">
    <div class="competence-list">
      {{!-- Can be added and removed in play mode too, like the inventory (#46) --}}
      {{> "kristallpunk.item-list" list=competenceList}}
    </div>

    <div class="magic">
      <div class="text-field">
        <label for="{{rootId}}-resonance-magic">{{systemFields.resonanceMagic.label}}</label>
        <input id="{{rootId}}-resonance-magic" type="text" name="system.resonanceMagic" value="{{system.resonanceMagic}}"
               data-lockable {{disabled locked}}>
      </div>
      <div class="text-field">
        <label for="{{rootId}}-resonance-competences">{{systemFields.resonanceCompetences.label}}</label>
        <textarea id="{{rootId}}-resonance-competences" name="system.resonanceCompetences" rows="7"
                  data-lockable {{disabled locked}}>{{system.resonanceCompetences}}</textarea>
      </div>
    </div>
  </div>
</section>
