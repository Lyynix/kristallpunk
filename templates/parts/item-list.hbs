{{!-- List of a figure's items of one type (#45); see module/sheets/item-list.mjs. Expects `list`. --}}
<section class="item-list-group {{list.type}}">
  <header class="item-row header {{#if list.detailLabel}}with-detail{{/if}}">
    <span class="name">{{list.label}}</span>
    {{#if list.detailLabel}}<span class="detail">{{list.detailLabel}}</span>{{/if}}
    <span class="controls">
      {{#if @root.editable}}
      <button type="button" class="inline-control icon fa-solid fa-plus" data-action="createItem" data-type="{{list.type}}"
              data-tooltip="{{list.createHint}}" aria-label="{{list.createHint}}"></button>
      {{/if}}
    </span>
  </header>
  <ol class="item-list">
    {{#each list.items as |item|}}
    <li class="item-row draggable {{#if ../list.detailLabel}}with-detail{{/if}}" data-item-id="{{item.id}}">
      <span class="name">
        <img src="{{item.img}}" alt="" inert>
        <a data-action="editItem">{{item.name}}</a>
        {{#if item.automation}}
        <i class="automation {{item.automation.level}} fa-solid {{item.automation.icon}}"
           data-tooltip="{{item.automation.label}}" aria-label="{{item.automation.label}}" role="img"></i>
        {{/if}}
      </span>
      {{#if ../list.detailLabel}}
      <span class="detail">
        {{#if item.warning}}
        <i class="warning fa-solid fa-triangle-exclamation" data-tooltip="{{item.warning}}" aria-label="{{item.warning}}" role="img"></i>
        {{else}}
        <span data-tooltip="{{item.detail}}">{{item.detail}}</span>
        {{/if}}
      </span>
      {{/if}}
      <span class="controls">
        {{!-- Edit and delete sit in a menu, so the name gets the room (#46); right-clicking the row opens it too --}}
        <button type="button" class="inline-control icon fa-solid fa-ellipsis-vertical" data-item-menu
                data-tooltip="{{localize "KRISTALLPUNK.Items.Menu"}}" aria-label="{{localize "KRISTALLPUNK.Items.Menu"}}"></button>
      </span>
    </li>
    {{else}}
    <li class="item-row empty">{{localize "KRISTALLPUNK.Items.None"}}</li>
    {{/each}}
  </ol>
</section>
